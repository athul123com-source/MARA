[TEMPLATE]
# Copy to .env and fill in your real keys. NEVER commit .env.
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Qdrant: pick ONE backend.
# 1) Server (Docker or Qdrant Cloud):
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# 2) Embedded on-disk (no Docker needed — recommended for dev on this PC):
# QDRANT_PATH=./qdrant_storage
# 3) If neither is set, an in-memory store is used (lost on restart).
